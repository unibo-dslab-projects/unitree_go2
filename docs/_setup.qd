.docdescription {Unitree Go2 mapping and navigation}
.doclang {English}
.theme {paperwhite} layout:{minimal}

.pagemargin {topleft}
    [.icon {book} Unitree Go2](./main.qd)

.pagemargin {topright}
    [.icon {github}](https://github.com/unibo-dslab-projects/unitree_go2 "Source repository")

.html
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Patrick+Hand&display=swap">
    <style>
    body.quarkdown.quarkdown-docs > header a:has(> .bi) {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    body.quarkdown.quarkdown-docs > header a > .bi {
      font-size: 1.3em;
    }
    /* the minimal layout fills the current page link with red */
    body.quarkdown.quarkdown-docs aside nav[data-role=page-list] a[aria-current] {
      background-color: transparent;
      color: var(--qd-link-color);
    }
    /* quarkdown gives each sidebar 20vw and the page 45rem; here the sidebars hug
       their links and the page takes the rest. below 1200px quarkdown stacks them. */
    @media screen and (min-width: 1201px) {
      body.quarkdown.quarkdown-docs > :is(header, .content-wrapper) > aside {
        flex: 0 0 auto;
        width: max-content;
        max-width: 25vw;
        margin: 0;
        padding-left: 40px;
        padding-right: 40px;
      }
      /* quarkdown adds 64px next to each sidebar through :first-child and :last-child */
      body.quarkdown.quarkdown-docs > :is(header, .content-wrapper) > aside:is(:first-child, :last-child) {
        margin: 0;
      }
      body.quarkdown.quarkdown-docs > :is(header, .content-wrapper) > main {
        flex: 1 1 auto;
        min-width: 0;
        max-width: none;
        padding: 0 48px;
        box-sizing: border-box;
      }
    }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/svg2roughjs@3.2.3/dist/svg2roughjs.umd.min.js"></script>
    <script>
    (function () {
      var FONT = "Patrick Hand";
      var ROUGHNESS = 1.8;
      // types the bundled mermaid draws by hand itself; svg2roughjs redraws the rest
      var NATIVE = /^(flowchart|class|state|er$|requirement|mindmap|kanban)/;
      var CONFIG = {
        startOnLoad: false,
        look: "handDrawn",
        handDrawnSeed: 7,
        theme: "neutral",
        // svg2roughjs only copies svg text, not html labels
        htmlLabels: false,
        flowchart: { htmlLabels: false },
        // neutral leaves note text white, which svg2roughjs keeps on a white note
        themeVariables: { fontFamily: '"' + FONT + '", cursive', noteBkgColor: "#fff5ad", noteTextColor: "#333333" }
      };

      function patch(m) {
        if (m.__sketch) return;
        m.__sketch = true;
        // quarkdown calls initialize with its own options, so ours are merged on top
        var init = m.initialize.bind(m);
        m.initialize = function (cfg) { init(Object.assign({}, cfg, CONFIG)); };
        // mermaid sizes boxes from the font, so it must be loaded first
        var render = m.render.bind(m);
        m.render = function () {
          var args = arguments;
          return document.fonts.load('16px "' + FONT + '"').catch(function () {})
            .then(function () { return render.apply(null, args); });
        };
        m.initialize({});
      }

      function sketch(svg) {
        var type = svg.getAttribute("aria-roledescription") || "";
        if (NATIVE.test(type) || svg.hasAttribute("data-sketched")) return;
        svg.setAttribute("data-sketched", "");
        // svg2roughjs sizes from width/height, and mermaid writes width="100%"
        var vb = svg.viewBox.baseVal;
        var width = svg.style.width;
        svg.setAttribute("width", vb.width);
        svg.setAttribute("height", vb.height);
        var host = document.createElement("div");
        var s = new svg2roughjs.Svg2Roughjs(host, svg2roughjs.OutputType.SVG);
        s.svg = svg;
        s.fontFamily = FONT;
        s.randomize = false;
        s.roughConfig = { roughness: ROUGHNESS, bowing: 1, fillStyle: "hachure", hachureGap: 6, fillWeight: 0.8, seed: 7 };
        s.sketch().then(function () {
          var out = host.querySelector("svg");
          out.setAttribute("data-sketched", "");
          svg.replaceWith(out);
          // mermaid viewBox often starts negative; fit the box to what was drawn
          var box = out.getBBox();
          var pad = 6;
          out.setAttribute("viewBox", (box.x - pad) + " " + (box.y - pad) + " " + (box.width + 2 * pad) + " " + (box.height + 2 * pad));
          out.removeAttribute("width");
          out.removeAttribute("height");
          out.style.width = width || "100%";
          out.style.maxWidth = "100%";
        }).catch(function (e) { console.error("mermaid sketch failed", e); });
      }

      if (window.mermaid) patch(window.mermaid);
      else document.addEventListener("DOMContentLoaded", function () { if (window.mermaid) patch(window.mermaid); });

      // quarkdown swaps the svg in, sometimes from its sessionStorage cache, so watch for it
      new MutationObserver(function () {
        document.querySelectorAll(".mermaid > svg:not([data-sketched])").forEach(sketch);
      }).observe(document.documentElement, { childList: true, subtree: true });
    })();
    </script>

.footer
    Unitree Go2 · Nicolò Ghignatti
