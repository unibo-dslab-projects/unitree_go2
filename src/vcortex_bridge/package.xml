<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vcortex_bridge</name>
  <version>0.0.0</version>
  <description>send map_builder's map and poses to the vcortex backend over a websocket</description>
  <maintainer email="nick.ghignatti@gmail.com">nick</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>boost</depend>
  <depend>geometry_msgs</depend>
  <depend>go2_mapping_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
